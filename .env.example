APP_NAME=StudyMate
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATA_DIR=data
DB_DIR=data/db
QUESTION_PAPERS_DIR=data/question_papers
SYLLABUS_DIR=data/syllabus
TEXTBOOKS_DIR=data/textbooks
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
VLLM_BASE_URL=http://localhost:11434
LLM_MAIN_MODEL=qwen2.5:3b
LLM_SOCRATIC_MODEL=qwen2.5:3b
LLM_SMALL_MODEL=qwen2.5:3b
LLM_MOCK_MODEL=qwen2.5:7b
VECTOR_DIR=data/db/faiss
TOP_K=5
MIN_SIMILARITY=0.30
CHUNK_SIZE=700
CHUNK_OVERLAP=120
SUBJECTS=physics,chemistry,mathematics,biology
LEVELS=1st,2nd
QUESTION_PAPER_BOARDS=cbse,ka

# Persona relevance gate: development default, calibrate with your evaluation data
PERSONA_MIN_SIMILARITY=0.30

# Persistent learner records and server integrations
# Production: supply a base64-encoded 32-byte key through a secret manager.
# Development: an automatic local key is stored at DB_DIR/.storage-key.
STORAGE_KEY=
RETENTION_DAYS=30
TEACHER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://127.0.0.1:3000
WHISPER_MODEL=base
# Enabling this sends response text to Google's TTS service.
ENABLE_GTTS=false
RATE_LIMIT_PER_MINUTE=60
DOCUMENT_TOKENS=500
DOCUMENT_OVERLAP=50

# --- Optional: Vertex AI instead of local Ollama -------------------------
# Requires: pip install google-auth, and application default credentials.
# Leaving these empty keeps all inference on the local Ollama runtime.
# LLM_AUTH=google
# LLM_CHAT_URL=https://us-central1-aiplatform.googleapis.com/v1beta1/projects/PROJECT_ID/locations/us-central1/endpoints/openapi/chat/completions
# LLM_MAIN_MODEL=google/gemini-2.5-flash
# LLM_SOCRATIC_MODEL=google/gemini-2.5-flash
# LLM_SMALL_MODEL=google/gemini-2.5-flash
# LLM_MOCK_MODEL=google/gemini-2.5-flash
